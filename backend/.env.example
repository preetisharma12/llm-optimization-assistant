# Copy this file to .env and fill in your own values.
# Never commit the real .env file -- it is already excluded via .gitignore.

# Required: API key for your OpenAI-compatible provider
OPENAI_API_KEY=your-api-key-here

# Optional: only needed if you are using Azure OpenAI or another
# OpenAI-compatible endpoint instead of api.openai.com
OPENAI_API_BASE=

# Optional: model name to use (defaults to gpt-4o-mini if unset)
LLM_MODEL=gpt-4o-mini
